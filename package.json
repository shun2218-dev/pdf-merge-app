{
	"name": "pdf-merge-app",
	"version": "1.2.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"analyze": "next experimental-analyze",
		"build-storybook": "storybook build",
		"dev": "next dev",
		"start": "next start",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"knip": "knip",
		"storybook": "storybook dev -p 6006",
		"test:unit": "vitest",
		"test:unit:coverage": "vitest --coverage",
		"test:unit:ui": "vitest --ui",
		"test:unit:ci": "vitest run --project unit",
		"test:storybook": "vitest run --project storybook --coverage.enabled=false",
		"test:e2e": "playwright test",
		"test:perf": "playwright test --config playwright.perf.config.ts",
		"lhci": "node scripts/lighthouse-ci.ts",
		"test:e2e:trace": "playwright test --trace on",
		"test:e2e:report": "playwright test --trace on && playwright show-report",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:gen": "playwright codegen http://localhost:3000"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.3",
		"@react-pdf-viewer/core": "^3.12.0",
		"@react-pdf-viewer/default-layout": "^3.12.0",
		"@sentry/nextjs": "^10.75.3",
		"@vercel/analytics": "^1.5.0",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.454.0",
		"next": "16.3.5",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^3.11.174",
		"posthog-js": "^1.434.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^2.5.5",
		"web-vitals": "^6.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@chromatic-com/storybook": "4.1.2",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.56.1",
		"@storybook/addon-a11y": "10.0.2",
		"@storybook/addon-docs": "10.0.2",
		"@storybook/addon-onboarding": "10.0.2",
		"@storybook/addon-vitest": "10.0.2",
		"@storybook/nextjs-vite": "^10.0.2",
		"@storybook/react": "10.0.2",
		"@tailwindcss/postcss": "^4.1.9",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/debug": "^4.1.12",
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.1.0",
		"@vitest/browser": "^4.0.5",
		"@vitest/browser-playwright": "^4.0.5",
		"@vitest/browser-preview": "^4.0.5",
		"@vitest/browser-webdriverio": "^4.0.5",
		"@vitest/coverage-v8": "^4.0.5",
		"@vitest/ui": "^4.0.5",
		"dotenv": "^17.2.3",
		"jsdom": "^25.0.1",
		"knip": "6.37.0",
		"playwright": "^1.56.1",
		"postcss": "^8.5",
		"storybook": "10.0.2",
		"tailwindcss": "^4.1.9",
		"tw-animate-css": "1.3.3",
		"typescript": "^5",
		"vite": "^6.0.7",
		"vitest": "^4.0.5"
	},
	"volta": {
		"node": "24.11.0"
	}
